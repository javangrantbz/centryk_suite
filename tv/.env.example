TV_APP_URL=http://localhost/centryk/tv
TV_UPLOAD_MAX_BYTES=5242880

STREAM_DRIVER=mock
STREAM_INGEST_URL=rtmp://stream.example.com/live
STREAM_PLAYBACK_BASE_URL=https://stream.example.com/hls
STREAM_API_URL=
# Shared secret the streaming server sends back to this app on every
# on_publish / on_publish_done / authorize_playback callback (see
# tv_require_stream_origin_secret() in includes/functions.php and
# docs/streaming-server.md's nginx.conf block). Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
STREAM_API_KEY=
# Browser "Go Live" (WHIP) publish endpoint - MediaMTX's WebRTC listener,
# separate from STREAM_INGEST_URL (RTMP, for OBS). See go-live.php.
STREAM_WHIP_URL=https://stream.example.com:8889
# TURN relay so Go Live works on cellular networks too, not just wifi
# (STUN alone can't traverse carrier-grade NAT). TURN_HOST is just the
# bare hostname (no scheme/port - go-live.php builds turn:/turns: URLs
# for ports 3478/5349 itself). TURN_SHARED_SECRET must match coturn's
# static-auth-secret on the streaming server. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
TURN_HOST=stream.example.com
TURN_SHARED_SECRET=
STREAM_SIGNING_SECRET=change-this-stream-signing-secret
TV_STREAM_CIPHER_KEY=change-this-encryption-key

# Comma-separated emails let through the production "coming soon" splash
# (tv_gate_coming_soon() in includes/functions.php) ahead of public launch -
# they must be logged into Centryk with a matching email to see real pages.
TV_COMING_SOON_ALLOWLIST=

