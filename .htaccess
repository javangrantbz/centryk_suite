RewriteEngine On

# Friendly error pages. The PHP layer (app/core/ErrorHandler.php) already
# renders public/errors/500.html for any uncaught exception or fatal; these
# are the backstop for faults that never reach PHP (bad .htaccess, PHP not
# starting) and for plain missing-file 404s. Paths start with public/ so the
# "route everything to public/" rule below leaves them alone.
ErrorDocument 500 /public/errors/500.html
ErrorDocument 404 /public/errors/404.html

# Block direct access to sensitive files and directories
RewriteRule ^(app|database)(/|$) - [F,L]

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Short links for TV displays (internal rewrite — URL bar stays short)
RewriteRule ^vb/([a-zA-Z0-9-]+)/?$ visionBoard/short.php?slug=$1 [L,QSA]

# Short links for public store pages (centryk.bz/s/<company-slug> → 301 to store.php)
RewriteRule ^s/([a-zA-Z0-9-]+)/?$ public/store-link.php?slug=$1 [L,QSA]

# Short links for public forms (centryk.bz/f/<share-token> → the fill page)
RewriteRule ^f/([a-zA-Z0-9]+)/?$ public/f.php?t=$1 [L,QSA]

# Memorable public entry points
RewriteRule ^store/?$     public/store.php     [L,QSA]
RewriteRule ^jobs/?$      public/jobs.php      [L,QSA]
RewriteRule ^directory/?$ public/directory.php [L,QSA]

# Route everything to public/
RewriteRule ^$ public/ [L]
RewriteRule ^((?!public/|visionBoard/).*) public/$1 [L]
