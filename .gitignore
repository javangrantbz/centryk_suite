# Environment — never commit credentials
.env

# Claude Code project context
.claude/

# Composer dependencies
vendor/
# …but keep the bundled dompdf for the integrated Invoices app (no composer on deploy)
!invoice-maker/vendor/
# Uploaded invoice logos / documents are runtime data, not source
public/invoice-maker/uploads/
invoice-maker/storage/documents/
# Uploaded BTS e-invoicing certificates (PFX/P12) + signed ETD XML - private,
# outside the web root; runtime data, not source. See FiscalInvoicingService.
storage/fiscal/

# Local scratch — reference images, scraped assets, integration keys. Never source.
gitignore/
xfer/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
